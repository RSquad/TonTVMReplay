+def _bits256_to_hex(value):
+    if isinstance(value, str):
+        if len(value) == 256 and all(ch in "01" for ch in value):
+            return hex(int(value, 2))[2:].upper().zfill(64)
+        return value.upper()
+    return hex(int(value))[2:].upper().zfill(64)
+
+
+def _first_tx_prev_marker(txs):
+    if not txs:
+        return None
+    first_tx = min(txs, key=lambda x: int(x["lt"]))
+    tx_tlb = Transaction().cell_unpack(first_tx["tx"], True)
+    return int(tx_tlb.prev_trans_lt), _bits256_to_hex(tx_tlb.prev_trans_hash)
+
+
+def _account_state_matches_tx_prev(account_state, expected_prev):
+    if expected_prev is None:
+        return True
+    expected_lt, expected_hash = expected_prev
+    return (
+        int(account_state.last_trans_lt) == int(expected_lt)
+        and _bits256_to_hex(account_state.last_trans_hash) == expected_hash
+    )
+
+
+def _account_state_to_shard_account_cell(account_state):
+    if not account_state.root.is_null():
+        return begin_cell() \
+            .store_ref(account_state.root) \
+            .store_uint(int(account_state.last_trans_hash, 16), 256) \
+            .store_uint(account_state.last_trans_lt, 64).end_cell()
+    return begin_cell() \
+        .store_ref(begin_cell().store_uint(0, 1).end_cell()) \
+        .store_uint(int(account_state.last_trans_hash, 16), 256) \
+        .store_uint(account_state.last_trans_lt, 64) \
+        .end_cell()
+
+
+def _tx_debug_enabled():
+    return os.getenv("TONPY_TX_DEBUG_LOG", "").strip().lower() in {"1", "true", "yes"}
+
+
+def _block_debug_id(block):
+    try:
+        bid = block["block_id"]
+        return f"wc={bid.id.workchain} shard={bid.id.shard:016X} seqno={bid.id.seqno} id={bid}"
+    except Exception:
+        return f"id={block.get('block_id')}"
+
+
+def _resolve_account_state_for_block(lc, block, acc, txs):
+    expected_prev = _first_tx_prev_marker(txs)
+    state_block = block['prev_block_left'] if shard_is_ancestor(
+        block['prev_block_left'].id.shard, acc.shard_prefix(60)
+    ) else block['prev_block_right']
+    mc_ref = block.get('mc_block_id')
+    last_error = None
+    fallback_state = None
+
+    def try_block(block_id):
+        nonlocal last_error, fallback_state
+        if block_id is None:
+            return None
+        try:
+            state = lc.get_account_state(acc, block_id)
+        except Exception as exc:
+            last_error = exc
+            return None
+        fallback_state = fallback_state or state
+        return state if _account_state_matches_tx_prev(state, expected_prev) else None
+
+    # Some archive lite servers effectively resolve account state by the
+    # corresponding masterchain reference and may reject exact shard references
+    # with "different reference block". In that mode, stay on the MC path only.
+    prefer_mc = os.getenv("GET_ACCOUNT_STATE_PREFER_MC", "").strip().lower() in {"1", "true", "yes"}
+    if prefer_mc:
+        state = try_block(mc_ref)
+    else:
+        state = try_block(state_block) or try_block(mc_ref)
+    if state is not None:
+        return state
+
+    if mc_ref is not None and getattr(mc_ref, "id", None) is not None and mc_ref.id.workchain == -1:
+        depth = int(os.getenv("GET_ACCOUNT_STATE_MC_FALLBACK_DEPTH", 16))
+        for seqno in range(int(mc_ref.id.seqno) + 1, int(mc_ref.id.seqno) + depth + 1):
+            state = try_block(lc.lookup_block(BlockId(-1, 0x8000000000000000, seqno)).blk_id)
+            if state is not None:
+                return state
+
+    if fallback_state is not None:
+        return fallback_state
+    raise last_error or RuntimeError(f"Unable to resolve account state for {acc.raw}")
+
