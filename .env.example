# TonTVMReplay Configuration Example
# Copy this file to .env and configure with your values

# ==============================================================================
# Required: Liteserver Configuration (multiple servers for failover)
# ==============================================================================

# Primary liteserver
export LITESERVER_SERVER_1=1546283254  # Liteserver IP as integer
export LITESERVER_PORT_1=40000
export LITESERVER_PUBKEY_1="GjXrSdCva4XNCBiIqT66fwurPAAie8U7VCQzbMMB2bM="

# Backup liteserver (optional but recommended)
export LITESERVER_SERVER_2=1556916838
export LITESERVER_PORT_2=40000
export LITESERVER_PUBKEY_2="86Fv9PfDfaaXlhiqzrbXEvUzE0ZPt9oUWeAAybjElok="

# Additional liteserver (optional)
export LITESERVER_SERVER_3=1546283252
export LITESERVER_PORT_3=40000
export LITESERVER_PUBKEY_3="UlHHRAabFKO4UYyRvrtxfWJtjCBpfyABJH7SldK43/o="

export LITESERVER_TIMEOUT=15  # Timeout per request in seconds

# ==============================================================================
# Required: Emulator Paths
# ==============================================================================
export EMULATOR_PATH=rust/libemulator.so              # Primary emulator (Rust)
export EMULATOR_UNCHANGED_PATH=cpp/libemulator.so     # Baseline emulator (C++) for comparison

# ==============================================================================
# Scenario Selection (choose one by uncommenting)
# ==============================================================================

# --- Scenario 1: Single Trace Mode ---
# Analyze a single transaction trace
# export TONCENTER_TX_HASH="<transaction_hash_hex_or_base64>"
# export TONCENTER_API_KEY="<your_api_key>"  # Optional, for rate limits

# --- Scenario 2: Multi-Trace Mode ---
# Batch process multiple traces within a time range
export TONCENTER_TRACES_BY_MASTERS=TRUE
export FROM_SEQNO=57220169  # Start masterchain seqno
export TO_SEQNO=57220269    # End masterchain seqno

# --- Scenario 3: Whitelist Mode ---
# Process specific transactions from JSON file
# export TXS_TO_PROCESS_PATH=./trace.json

# --- Scenario 4: Liteserver Base Mode (Sequential Scan) ---
# Scan recent blocks (automatic if no other scenario configured)
# export FROM_SEQNO=45000000
# export TO_SEQNO=45000100
# OR use recent blocks:
# export TO_EMULATE_MC_BLOCKS=10  # Last N blocks

# ==============================================================================
# Optional: Advanced Configuration
# ==============================================================================

# Performance tuning
export NPROC=10                # Parallel worker processes
export CHUNK_SIZE=4            # Blocks per iteration
export TX_CHUNK_SIZE=30        # Transactions per batch (reduce if low RAM)

# Logging
export EMUSO_LOGLEVEL=2        # 0=trace, 1=debug, 2=info, 3=warning, 4=error

# Filtering
# export ONLYMC_BLOCK=true     # Emulate only masterchain blocks
# export PARSE_OVER_LS=true    # Parse transactions via liteserver

# Diff validation
export COLOR_SCHEMA_PATH=./diff_colored.json  # Path to color schema JSON

# Configuration override (for testing)
# export C7_REWRITE='{"1": "te6ccgEBAQEAAgAAAA=="}'  # Override config params

# Toncenter API
# export TONCENTER_API="https://toncenter.com/api/v3"
# export TONCENTER_API_KEY="<your_key>"
